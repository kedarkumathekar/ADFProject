{
	"name": "DataTransformationdemo",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DimFlight",
						"type": "DatasetReference"
					},
					"name": "DimFlight"
				},
				{
					"dataset": {
						"referenceName": "DimPassenger",
						"type": "DatasetReference"
					},
					"name": "DimPassenger"
				},
				{
					"dataset": {
						"referenceName": "DimAIrline",
						"type": "DatasetReference"
					},
					"name": "DimAirline"
				},
				{
					"dataset": {
						"referenceName": "sqlinput",
						"type": "DatasetReference"
					},
					"name": "FactBookings"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "sinkAirline",
					"rejectedDataLinkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					}
				},
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "sinkPassengerData",
					"rejectedDataLinkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "JoinAirline"
				},
				{
					"name": "SelectCols"
				},
				{
					"name": "aggregateCost"
				},
				{
					"name": "castTicketPrice"
				},
				{
					"name": "windowCost"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "filterRank"
				},
				{
					"name": "derivedGenderMale"
				},
				{
					"name": "derivedGenderFemale"
				},
				{
					"name": "SplitcolumnName"
				},
				{
					"name": "GroupbyCountry"
				},
				{
					"name": "filtercountry"
				},
				{
					"name": "alterPassenger"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimFlight",
				"source(output(",
				"          passenger_id as short,",
				"          full_name as string,",
				"          gender as string,",
				"          age as short,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimPassenger",
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimAirline",
				"source(output(",
				"          airline_id as short,",
				"          booking_date as string,",
				"          booking_id as short,",
				"          checkin_status as boolean,",
				"          destination_airport_id as short,",
				"          flight_duration_mins as short,",
				"          flight_id as short,",
				"          origin_airport_id as short,",
				"          passenger_id as short,",
				"          ticket_cost as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> FactBookings",
				"DimAirline, FactBookings join(DimAirline@airline_id == FactBookings@airline_id,",
				"     joinType:'right',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinAirline",
				"JoinAirline select(mapColumn(",
				"          airline_name,",
				"          country,",
				"          airline_id = FactBookings@airline_id,",
				"          booking_date,",
				"          booking_id,",
				"          checkin_status,",
				"          destination_airport_id,",
				"          flight_duration_mins,",
				"          flight_id,",
				"          origin_airport_id,",
				"          passenger_id,",
				"          ticket_cost",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectCols",
				"castTicketPrice aggregate(groupBy(airline_name),",
				"     Total_cost = sum(ticket_cost)) ~> aggregateCost",
				"SelectCols cast(output(",
				"          ticket_cost as integer",
				"     ),",
				"     errors: true) ~> castTicketPrice",
				"aggregateCost window(desc(Total_cost, true),",
				"     Rank = denseRank()) ~> windowCost",
				"filterRank alterRow(upsertIf(1==1)) ~> alterRow1",
				"windowCost filter(Rank<=5) ~> filterRank",
				"DimPassenger derive(gender = regexReplace(gender, 'M', 'Male')) ~> derivedGenderMale",
				"derivedGenderMale derive(gender = regexReplace(gender, 'F', 'Female')) ~> derivedGenderFemale",
				"derivedGenderFemale derive(FirstName = split(full_name, \" \")[1],",
				"          LastName = split(full_name, \" \")[2]) ~> SplitcolumnName",
				"SplitcolumnName aggregate(groupBy(country),",
				"     Total_count = count(passenger_id)) ~> GroupbyCountry",
				"GroupbyCountry filter(Total_count>1) ~> filtercountry",
				"filtercountry alterRow(insertIf(1==1)) ~> alterPassenger",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'csvdata',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['airline_name'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkAirline",
				"alterPassenger sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'csvData',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkPassengerData"
			]
		}
	}
}